# SAP Landscape Agent Environment Configuration
# Lab 06: SAP Assistant with RAG
$env:GOOGLE_GENAI_USE_VERTEXAI = "true"
$env:GOOGLE_CLOUD_PROJECT = "genai-2222026"
$env:GOOGLE_CLOUD_LOCATION = "us-central1"
# GCP Project Settings (used by adk deploy)
GOOGLE_CLOUD_PROJECT=genai-2222026
GOOGLE_CLOUD_LOCATION=us-central1
#GOOGLE_API_KEY=AQ.-XyUmqpt34iJa3lOyrxBhCaKl3jXAb8RN6LaXshSN8qHM3cJEw
# Staging bucket for deployment artifacts
STAGING_BUCKET=gs://srini118bucket

# Agent display name in GCP Console
AGENT_DISPLAY_NAME=SAP Landscape Assistant

# Optional: Service account for deployment
SERVICE_ACCOUNT=vertex-pipeline-sa@genai-2222026.iam.gserviceaccount.com

# Optional: Logging level
LOG_LEVEL=INFO

# Optional: Knowledge base path for RAG implementation
KNOWLEDGE_BASE_PATH=./knowledge_base

# Optional: SAP connection settings (for future implementation)
